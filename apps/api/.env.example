DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booklet?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# This server's own public URL -- must exactly match the redirect URI
# registered with each OAuth provider below.
API_ORIGIN="http://localhost:4000"

# required -- signs access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""

# where uploaded PDFs/EPUBs and generated podcast audio are written. Optional
# locally -- unset, it defaults to apps/api/storage/, which is fine for dev.
# NOT optional in a deployment: it must be an absolute path on a mounted
# persistent disk, or every uploaded book is destroyed on the next redeploy
# while its database row survives, pointing at a file that no longer exists.
# Treat it exactly like DATABASE_URL. See DEPLOYMENT.md.
FILE_STORAGE_PATH=""

# optional -- password reset, email verification, and digest emails log to
# the console instead of sending when this is unset. Get a key at resend.com.
RESEND_API_KEY=""
EMAIL_FROM="Booklet <onboarding@resend.dev>"

# optional -- error monitoring is a no-op without this. Get a DSN at sentry.io.
SENTRY_DSN=""

# optional -- "Sign in with Google/GitHub" only appears when its pair is
# set (GET /api/auth/oauth/providers reports which). Register a redirect
# URI of {API_ORIGIN}/api/auth/oauth/google/callback (or /github/callback):
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# optional -- shared, persistent cache for generated read-aloud audio. Without
# it the API still caches in-process, but loses everything on restart and
# shares nothing between instances. See DEPLOYMENT.md; set maxmemory and
# allkeys-lru on the Redis itself.
REDIS_URL=""

# set to "true" ONLY when a reverse proxy/load balancer you control sits in
# front of this server. Rate limiting keys on the client IP, which without
# this resolves to the proxy -- putting every user in one shared bucket. With
# no proxy in front, leaving it unset is what stops clients spoofing
# X-Forwarded-For to dodge the limit entirely. See DEPLOYMENT.md.
TRUST_PROXY=""

# optional -- absolute base for the podcast feed URL and its <enclosure>s.
# Defaults to the request's own Host header, which is right locally and in
# docker-compose. Needed behind a TLS-terminating proxy: request.protocol
# reads "http" there unless TRUST_PROXY is set, and an https feed handing out
# http enclosures is a downgrade iOS refuses to download at all.
API_PUBLIC_URL=""

# Everything above is what a local dev run needs. The production sizing and
# rate-limit knobs (TTS_POOL_SIZE, TTS_CACHE_MAX_MB, TTS_REDIS_TTL_DAYS,
# GLOBAL_RATE_LIMIT_MAX, TTS_RATE_LIMIT_MAX, TTS_WARM_RATE_LIMIT_MAX,
# AUTH_ATTEMPT_RATE_LIMIT_MAX, AUTH_REFRESH_RATE_LIMIT_MAX,
# AUTH_FAILED_LOGIN_LIMIT, PUBLIC_SHARE_RATE_LIMIT_MAX, PODCAST_VOICE,
# OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_SERVICE_NAME) all have working defaults
# and are deliberately not listed here, so this file stays a setup checklist
# rather than a config dump. Every one is documented in DEPLOYMENT.md.
