generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Without these, the generated client's *own* internal relative imports
  // (e.g. "./internal/class") come out extension-less -- fine for tsc's
  // Bundler moduleResolution (which this project otherwise wants, since dev
  // runs on tsx), but plain `node dist/index.js` in production requires an
  // explicit extension on every relative ESM import and fails to start
  // without one. Forcing .js here makes the generated *source* already
  // correct, so tsc's compiled output is too.
  moduleFormat         = "esm"
  importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum ArticleStatus {
  UNREAD
  READING
  ARCHIVED
}

enum SourceType {
  HTML
  PDF
  EPUB
}

enum ExtractionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  PINK
  ORANGE
}

enum ResurfaceFeedback {
  REMEMBERED
  FORGOT
}

enum ResurfaceFrequency {
  DAILY
  WEEKLY
}

// ---------- Models ----------

model User {
  id String @id @default(cuid())
  email String @unique
  // Nullable: an account created via OAuth (see OAuthAccount) never sets
  // one -- login-by-password just isn't an option for that user, rather
  // than issuing them a random password they'll never know.
  passwordHash    String?
  name            String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  articles                Article[]
  highlights              Highlight[]
  annotations             Annotation[]
  collections             Collection[]
  sessions                Session[]
  digests                 Digest[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  oauthAccounts           OAuthAccount[]
  feeds                   Feed[]

  resurfaceFrequency  ResurfaceFrequency @default(DAILY)
  highlightsPerDigest Int                @default(5)
}

// One row per (provider, external account) a user has signed in with.
// Looked up on every OAuth callback to find the existing user; if none
// matches but a User with the same (provider-verified) email already
// exists, the account gets linked to it instead of creating a duplicate --
// see lib/auth/oauth.ts.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

// A subscription, not a cache of items -- there's no background worker in
// this app to poll feeds on a schedule, so items are fetched live (SSRF-
// hardened the same way article extraction is) whenever the RSS page is
// visited rather than persisted here. See services/rss-service.ts.
model Feed {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url   String
  title String? // the feed's own <title>, captured once at subscribe time

  createdAt DateTime @default(now())

  @@unique([userId, url])
  @@index([userId])
}

// Single-use, short-lived tokens for "forgot password" -- only the hash is
// stored (same reasoning as Session.refreshTokenHash): a DB read alone
// should never be enough to reset someone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Refresh-token store behind the JWT auth. Access tokens are short-lived,
// stateless JWTs; this table exists so "log out" and revocation actually
// work, and so we have a real user-session concept to hand off to
// Clerk/Auth0 later without touching anything below this model.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model Article {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url      String? // null for PDF/EPUB uploads -- there's no source URL for those
  // Normalized form of `url` (tracking params stripped, host/trailing-slash
  // normalized -- see url-canonicalize.ts), used to catch a "different URL,
  // same article" duplicate (an AMP link, a ?utm_source=... share link)
  // that exact-string matching on `url` above misses. Not shown to the
  // user; `url` stays whatever they actually saved. Null for PDF/EPUB
  // uploads, same as `url`, and for any article saved before this field
  // existed (not backfilled -- an old row just won't be duplicate-checked
  // against by this mechanism until it's touched again).
  canonicalUrl String?
  title    String?
  author   String?
  siteName String?
  excerpt  String?

  sourceType       SourceType       @default(HTML)
  extractionStatus ExtractionStatus @default(PENDING)
  extractionError  String?
  extractedHtml    String?          @db.Text // HTML only -- Readability output rendered in the reader
  extractedText    String?          @db.Text // all types -- HTML/PDF full text, EPUB full book text; search + reading-time estimate
  fileStorageKey   String? // key into StorageService (filesystem now, S3 later) -- raw fetched HTML snapshot (HTML) or the uploaded file itself (PDF/EPUB), not read on hot paths
  originalFilename String? // PDF/EPUB upload's original filename -- fallback title source when metadata extraction comes up empty

  readingTimeEstimate Int? // minutes, computed from extractedText at save time
  progressFraction    Float @default(0) // 0.0-1.0, normalized regardless of sourceType (page/total, CFI/total, or scroll position)
  // Actual active reading time, seconds -- only accrues while the reader tab
  // is visible (reader-view.tsx). Written as an atomic increment (a delta
  // since the last flush), not an overwrite, same periodic timer as
  // progressFraction -- see the reading-stats feature.
  activeReadingSeconds Int @default(0)

  // Free-form, lighter-weight than Collection on purpose: no separate entity
  // to create/rename/delete, no color, just strings on the article itself.
  // Postgres native array, not a join table -- fine at this app's per-user
  // scale; a GIN index is the usual next step if "has tag X" filtering ever
  // needs to be fast against a much bigger table than one person's library.
  tags String[] @default([])

  status     ArticleStatus @default(UNREAD)
  savedAt    DateTime      @default(now())
  readAt     DateTime?
  archivedAt DateTime?

  favorited Boolean @default(false)
  // Trash is separate from `status` -- deleting sets this instead of
  // removing the row outright, independent of whatever status (UNREAD/
  // READING/ARCHIVED) it had, so restoring gives it back. A row with this
  // set is excluded from every normal query and shown in the Trash view
  // instead; rows past the 30-day retention window are purged lazily (see
  // services/trash-service.ts) rather than needing a cron/scheduled job.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  highlights  Highlight[]
  collections ArticleCollection[]

  @@unique([userId, url])
  @@index([userId, status])
  @@index([userId, savedAt])
  @@index([userId, favorited])
  @@index([userId, deletedAt])
  @@index([userId, canonicalUrl])
}

model Highlight {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String // denormalized from article.userId -- keeps the cross-article
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade) // Highlights Dashboard query and ownership checks a single-table lookup

  selectedText String @db.Text

  /// Discriminated by position.type: "text" (HTML, W3C TextQuote+TextPosition
  /// selectors against Article.extractedText) | "pdf" (page + rects, PDF
  /// user-space units) | "epub" (a CFI range). See packages/shared
  /// HighlightPosition for the exact shape per type.
  position Json

  color HighlightColor @default(YELLOW)

  lastSurfacedAt DateTime?
  surfaceCount   Int       @default(0)

  lastFeedback        ResurfaceFeedback? // set by "remembered this" / "forgot this"
  lastFeedbackAt      DateTime?
  resurfaceArchivedAt DateTime? // "archive this highlight" -- null = still eligible

  /// SM-2 spaced-repetition state (packages/shared resurface.ts applySm2Review).
  /// nextDueAt null = never reviewed, due immediately.
  easinessFactor Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  nextDueAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  annotation Annotation?
  digests    Digest[] // which resurfacing batches this highlight has appeared in

  @@index([articleId])
  @@index([userId, createdAt])
  @@index([userId, nextDueAt])
}

model Digest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  generatedAt DateTime  @default(now())
  viewedAt    DateTime? // in-app "seen" marker
  emailSentAt DateTime? // stub -- set when the logged-not-sent email step runs

  highlights Highlight[]

  @@index([userId, generatedAt])
}

model Annotation {
  id          String    @id @default(cuid())
  highlightId String    @unique // one optional note per highlight, per the spec ("a note attached to a highlight")
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  noteText String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles ArticleCollection[]

  @@unique([userId, name])
}

model ArticleCollection {
  articleId    String
  article      Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([articleId, collectionId])
}
