generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Without these, the generated client's *own* internal relative imports
  // (e.g. "./internal/class") come out extension-less -- fine for tsc's
  // Bundler moduleResolution (which this project otherwise wants, since dev
  // runs on tsx), but plain `node dist/index.js` in production requires an
  // explicit extension on every relative ESM import and fails to start
  // without one. Forcing .js here makes the generated *source* already
  // correct, so tsc's compiled output is too.
  moduleFormat         = "esm"
  importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum ArticleStatus {
  UNREAD
  READING
  ARCHIVED
}

enum SourceType {
  HTML
  PDF
  EPUB
  // A book with no web URL and no uploaded file -- specifically for
  // highlights imported from a Kindle My Clippings.txt export (see
  // kindle-clippings.ts), where all that exists is the book's title/author
  // and its highlights, not the book's actual content.
  BOOK
}

enum ExtractionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ResurfaceFeedback {
  REMEMBERED
  FORGOT
}

enum ResurfaceFrequency {
  DAILY
  WEEKLY
}

// ---------- Models ----------

model User {
  id String @id @default(cuid())
  email String @unique
  // Nullable: an account created via OAuth (see OAuthAccount) never sets
  // one -- login-by-password just isn't an option for that user, rather
  // than issuing them a random password they'll never know.
  passwordHash    String?
  name            String?
  emailVerifiedAt DateTime?
  // Amazon's own per-account "Send to Kindle" address (…@kindle.com or
  // …@free.kindle.com) -- entered once in Settings, then reused by the
  // "Send to Kindle" action (articles.ts) instead of asking every time.
  kindleEmail     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  articles                Article[]
  highlights              Highlight[]
  annotations             Annotation[]
  collections             Collection[]
  sessions                Session[]
  digests                 Digest[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  oauthAccounts           OAuthAccount[]
  feeds                   Feed[]
  apiTokens               ApiToken[]
  webhooks                Webhook[]
  readingActivityDays     ReadingActivityDay[]

  resurfaceFrequency  ResurfaceFrequency @default(DAILY)
  highlightsPerDigest Int                @default(5)
}

// Personal access token for /api/v1 -- long-lived and revocable, unlike
// the short-lived JWT access tokens the web/extension clients use (see
// lib/auth/tokens.ts). Only tokenHash is ever stored (same
// generateOpaqueToken/hashOpaqueToken pattern as refresh tokens and
// password-reset links) -- the raw token is shown exactly once, at
// creation, and can never be displayed again.
model ApiToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String // user-chosen label, e.g. "Zapier"
  tokenHash String   @unique
  scopes    String[] @default(["read", "write"])

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// A registered endpoint to notify on article/highlight events (see
// services/webhook-service.ts for delivery). `secret` signs each
// delivery's payload (HMAC-SHA256) so the receiver can verify it actually
// came from Booklet, same principle as GitHub/Stripe webhooks.
model Webhook {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url    String
  events String[]
  secret String
  active Boolean @default(true)

  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([userId])
}

// Delivery log -- lets a user see whether their webhook is actually
// working (last 20 or so) rather than it silently failing forever with no
// visibility, which is worse than not having the feature at all.
model WebhookDelivery {
  id        String  @id @default(cuid())
  webhookId String
  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  event      String
  statusCode Int?
  success    Boolean
  error      String?

  createdAt DateTime @default(now())

  @@index([webhookId, createdAt])
}

// One row per (provider, external account) a user has signed in with.
// Looked up on every OAuth callback to find the existing user; if none
// matches but a User with the same (provider-verified) email already
// exists, the account gets linked to it instead of creating a duplicate --
// see lib/auth/oauth.ts.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

// A subscription, not a cache of items -- there's no background worker in
// this app to poll feeds on a schedule, so items are fetched live (SSRF-
// hardened the same way article extraction is) whenever the RSS page is
// visited rather than persisted here. See services/rss-service.ts.
model Feed {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url   String
  title String? // the feed's own <title>, captured once at subscribe time

  createdAt DateTime @default(now())

  @@unique([userId, url])
  @@index([userId])
}

// Single-use, short-lived tokens for "forgot password" -- only the hash is
// stored (same reasoning as Session.refreshTokenHash): a DB read alone
// should never be enough to reset someone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Refresh-token store behind the JWT auth. Access tokens are short-lived,
// stateless JWTs; this table exists so "log out" and revocation actually
// work, and so we have a real user-session concept to hand off to
// Clerk/Auth0 later without touching anything below this model.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model Article {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url      String? // null for PDF/EPUB uploads -- there's no source URL for those
  // Normalized form of `url` (tracking params stripped, host/trailing-slash
  // normalized -- see url-canonicalize.ts), used to catch a "different URL,
  // same article" duplicate (an AMP link, a ?utm_source=... share link)
  // that exact-string matching on `url` above misses. Not shown to the
  // user; `url` stays whatever they actually saved. Null for PDF/EPUB
  // uploads, same as `url`, and for any article saved before this field
  // existed (not backfilled -- an old row just won't be duplicate-checked
  // against by this mechanism until it's touched again).
  canonicalUrl String?
  title    String?
  author   String?
  siteName String?
  excerpt  String?

  sourceType       SourceType       @default(HTML)
  extractionStatus ExtractionStatus @default(PENDING)
  extractionError  String?
  extractedHtml    String?          @db.Text // HTML only -- Readability output rendered in the reader
  extractedText    String?          @db.Text // all types -- HTML/PDF full text, EPUB full book text; search + reading-time estimate
  // Null for anything not OCR'd (which is most articles -- only a scanned
  // PDF with no usable text layer goes through OCR at all). "OCR" tells
  // the reader to show a "may contain errors" notice next to the text,
  // since Tesseract output has a real, non-trivial error rate a native
  // text layer or Readability extraction never would.
  textSource       String? // "NATIVE" | "OCR", see PdfExtractionResult
  fileStorageKey   String? // key into StorageService (filesystem now, S3 later) -- raw fetched HTML snapshot (HTML) or the uploaded file itself (PDF/EPUB), not read on hot paths
  originalFilename String? // PDF/EPUB upload's original filename -- fallback title source when metadata extraction comes up empty
  // data: URI thumbnail for the library card -- og:image (HTML), rendered
  // page 1 (PDF), or the declared/first-spine-image cover (EPUB). @db.Text
  // since a base64-encoded image is well beyond a bare VARCHAR's default.
  coverImageUrl    String?          @db.Text

  readingTimeEstimate Int? // minutes, computed from extractedText at save time
  // How many images in the original page were too large/numerous to inline
  // (see extraction-service.ts's MAX_IMAGE_BYTES/MAX_TOTAL_IMAGE_BYTES/
  // MAX_IMAGES) and were left pointing at the original site instead. 0 for
  // anything that isn't an HTML save, or where nothing was skipped.
  skippedImageCount   Int   @default(0)
  progressFraction    Float @default(0) // 0.0-1.0, normalized regardless of sourceType (page/total, CFI/total, or scroll position)

  // Read-aloud position, the listening sibling of progressFraction (#152).
  //
  // A fraction rather than a chunk index, deliberately. Chunk boundaries are a
  // function of FIRST_CHUNK_MAX_CHARS/MAX_CHUNK_CHARS, which are latency tuning
  // knobs that have already moved once (200 -> 140, see kokoro-tts.ts) -- an
  // index stored under one chunking silently points at different audio under
  // the next, and re-extracting an article changes the text underneath it too.
  // A fraction over the article's text survives both, and matches how
  // progressFraction already normalizes across wildly different source types.
  //
  // Nullable, unlike progressFraction: "never listened" has to be
  // distinguishable from "listened, at the very start", or the resume prompt
  // fires on every article nobody has ever played.
  listeningFraction   Float?
  listeningUpdatedAt  DateTime?
  // Which device wrote the position above. The resume prompt says "last played
  // on another device", and that claim needs somewhere to come from -- without
  // this, the tab that just wrote the position would offer to resume from
  // itself. Opaque client-generated id (see lib/reader/device-id.ts); it
  // identifies a browser, not a person, and is never shown to the user.
  listeningDeviceId   String?
  // Actual active reading time, seconds -- only accrues while the reader tab
  // is visible (reader-view.tsx). Written as an atomic increment (a delta
  // since the last flush), not an overwrite, same periodic timer as
  // progressFraction -- see the reading-stats feature.
  activeReadingSeconds Int @default(0)

  // Free-form, lighter-weight than Collection on purpose: no separate entity
  // to create/rename/delete, no color, just strings on the article itself.
  // Postgres native array, not a join table -- fine at this app's per-user
  // scale; a GIN index is the usual next step if "has tag X" filtering ever
  // needs to be fast against a much bigger table than one person's library.
  tags String[] @default([])

  status     ArticleStatus @default(UNREAD)
  savedAt    DateTime      @default(now())
  readAt     DateTime?
  archivedAt DateTime?

  favorited Boolean @default(false)
  // Trash is separate from `status` -- deleting sets this instead of
  // removing the row outright, independent of whatever status (UNREAD/
  // READING/ARCHIVED) it had, so restoring gives it back. A row with this
  // set is excluded from every normal query and shown in the Trash view
  // instead; rows past the 30-day retention window are purged lazily (see
  // services/trash-service.ts) rather than needing a cron/scheduled job.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Weighted tsvector over title/author/siteName/tags/excerpt/extractedText,
  /// backing ranked full-text search (#155). A Postgres GENERATED ALWAYS ...
  /// STORED column, so it can never drift from the row the way a trigger or
  /// application-maintained column can -- there is no write path that could
  /// forget to update it.
  ///
  /// Declared here purely so Prisma knows it exists. `Unsupported` means the
  /// client cannot read or write it, which is exactly right (search.ts reads
  /// it through raw SQL), but declaring it is not optional: without it,
  /// Prisma treats the column as drift and the next `migrate dev` offers to
  /// drop it. Its expression and GIN index live in the migration, since
  /// neither is expressible in this schema language.
  searchVector Unsupported("tsvector")?

  highlights  Highlight[]
  collections ArticleCollection[]
  embeddings  ArticleEmbedding[]

  @@unique([userId, url])
  @@index([userId, status])
  @@index([userId, savedAt])
  @@index([userId, favorited])
  @@index([userId, deletedAt])
  @@index([userId, canonicalUrl])
  /// The GIN index backing search (#155). Declared here as well as in its
  /// migration for the same reason searchVector itself is: anything Prisma
  /// cannot see, it treats as drift. Leaving it out made the very next
  /// `migrate dev` emit a DROP for it against the shadow database, which
  /// failed the whole migration -- a raw-SQL index is not a thing you can
  /// create once and forget about.
  @@index([searchVector], type: Gin)
}

// One row per (user, calendar day) that had any active reading time, for
// the stats page's GitHub-contributions-style heatmap. Deliberately its own
// small aggregate table rather than deriving "days read" from Article's own
// timestamps (savedAt/readAt/archivedAt): those only mark when an article
// was *started* or *finished*, so a day spent reading partway through an
// already-in-progress article -- finishing nothing, starting nothing new --
// wouldn't show up at all. `seconds` accumulates the same
// activeReadingSecondsDelta increments Article.activeReadingSeconds already
// receives (see articles.ts's PATCH handler), just bucketed by the day the
// reading actually happened instead of only living as one lifetime total
// per article.
model ReadingActivityDay {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Always midnight UTC of the calendar day -- a date, not a timestamp,
  // even though the column type has to be DateTime (Postgres DATE would be
  // more honest, but Prisma's cross-provider DateTime is what every other
  // model here already uses, and consistency matters more than shaving one
  // type out of the schema).
  date    DateTime
  seconds Int      @default(0)

  @@id([userId, date])
}

/// One embedded window of an article's text, for semantic search (#156).
///
/// Several rows per article, not one: all-MiniLM-L6-v2 truncates at 256 word
/// pieces, so embedding a whole article does not average it -- it embeds the
/// opening and silently discards the rest, making a mid-article passage
/// unfindable. See chunkForEmbedding in packages/shared.
///
/// `vector` is a plain Float[] (Postgres double precision[]) rather than a
/// pgvector column, and that is a decision this issue asked to be recorded
/// rather than a shortcut. pgvector is not available in the postgres:16 image
/// that CI and docker-compose both run -- `SELECT * FROM
/// pg_available_extensions WHERE name = 'vector'` returns nothing -- so
/// adopting it would mean changing the image in CI, in compose, and in
/// whatever a real deployment ends up using, plus an extension this app
/// otherwise has no need for. At one person's library, similarity over a few
/// thousand 384-float vectors is milliseconds in process. Revisit if a
/// library ever grows to where a scan is the bottleneck, which is the point
/// at which an ANN index actually earns its dependency.
model ArticleEmbedding {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// Denormalized from article.userId so a search can scope by user without
  /// joining -- same reasoning as Highlight.userId. Deliberately not a
  /// relation: it is a query-scoping copy, and the cascade that actually
  /// matters (article deleted -> embeddings deleted) comes from `article`.
  userId String

  chunkIndex Int
  vector     Float[]

  createdAt DateTime @default(now())

  @@unique([articleId, chunkIndex])
  @@index([userId])
}

model Highlight {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String // denormalized from article.userId -- keeps the cross-article
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade) // Highlights Dashboard query and ownership checks a single-table lookup

  selectedText String @db.Text

  /// Discriminated by position.type: "text" (HTML, W3C TextQuote+TextPosition
  /// selectors against Article.extractedText) | "pdf" (page + rects, PDF
  /// user-space units) | "epub" (a CFI range). See packages/shared
  /// HighlightPosition for the exact shape per type.
  position Json

  /// A legacy name ("YELLOW"/"GREEN"/"BLUE"/"PINK"/"ORANGE", the original
  /// fixed set, still the only ones that auto-adapt per reading theme) or
  /// a literal #RRGGBB hex the user picked directly -- see packages/shared
  /// highlight-colors.ts. Used to be a Postgres enum; loosened to text so
  /// highlight colors could be genuinely user-customizable.
  color String @default("YELLOW")

  lastSurfacedAt DateTime?
  surfaceCount   Int       @default(0)

  lastFeedback        ResurfaceFeedback? // set by "remembered this" / "forgot this"
  lastFeedbackAt      DateTime?
  resurfaceArchivedAt DateTime? // "archive this highlight" -- null = still eligible

  /// SM-2 spaced-repetition state (packages/shared resurface.ts applySm2Review).
  /// nextDueAt null = never reviewed, due immediately.
  easinessFactor Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  nextDueAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  annotation Annotation?
  digests    Digest[] // which resurfacing batches this highlight has appeared in

  @@index([articleId])
  @@index([userId, createdAt])
  @@index([userId, nextDueAt])
}

model Digest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  generatedAt DateTime  @default(now())
  viewedAt    DateTime? // in-app "seen" marker
  emailSentAt DateTime? // stub -- set when the logged-not-sent email step runs

  highlights Highlight[]

  @@index([userId, generatedAt])
}

model Annotation {
  id          String    @id @default(cuid())
  highlightId String    @unique // one optional note per highlight, per the spec ("a note attached to a highlight")
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  noteText String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String?
  // A saved-search filter (CollectionFilter, shared/types/collection.ts) --
  // when set, this collection's membership is computed live from Article
  // at read time instead of stored via ArticleCollection rows below. In
  // practice never combined with parentId (the UI never offers nesting a
  // smart collection), not hard-enforced here to keep this migration small.
  filter Json?

  // Self-referential for nested (folder-style) collections. onDelete:
  // SetNull rather than Cascade -- deleting a parent shouldn't take its
  // children with it, they just become top-level.
  parentId String?
  parent   Collection?  @relation("CollectionChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Collection[] @relation("CollectionChildren")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles ArticleCollection[]

  @@unique([userId, name])
  @@index([userId, parentId])
}

model ArticleCollection {
  articleId    String
  article      Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([articleId, collectionId])
}
