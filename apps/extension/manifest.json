{
  "manifest_version": 3,
  "name": "Booklet",
  "version": "0.1.0",
  "description": "Save the page you're on straight to your Booklet library.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Booklet",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": ["http://localhost:4000/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "{d701a11e-f67f-440e-a0b2-a96318f90109}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "bookmarksInfo"]
      }
    }
  }
}
