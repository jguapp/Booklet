NEXT_PUBLIC_API_URL="http://localhost:4000"

# optional -- error monitoring is a no-op without this. Get a DSN at sentry.io.
NEXT_PUBLIC_SENTRY_DSN=""

# optional -- Datadog RUM, which is what reports real-world time-to-first-audio
# for read-aloud (src/lib/rum.ts). Off, and the SDK never even downloaded,
# unless both are set. The RUM *client token* is publishable and write-only,
# which is what makes NEXT_PUBLIC_ correct for it -- a Datadog API key is not,
# and must never be given to the web app. Session replay is deliberately
# disabled: it would record whatever the reader is reading.
NEXT_PUBLIC_DD_RUM_APPLICATION_ID=""
NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=""
# optional -- your Datadog region's site (e.g. datadoghq.eu) if it isn't US1.
NEXT_PUBLIC_DD_SITE=""

# Every NEXT_PUBLIC_* var above is inlined into the client bundle at *build*
# time, not read at runtime -- so they have to be set when the web image is
# built, not just when it runs (see apps/web/Dockerfile's ARGs).
