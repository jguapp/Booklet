{
  "name": "booklet",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:db": "pnpm --filter @booklet/api dev:db",
    "dev:api": "pnpm --filter @booklet/api dev",
    "dev:web": "pnpm --filter @booklet/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  }
}
