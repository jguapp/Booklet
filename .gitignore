# dependencies
node_modules/
# Ignored in case a CI setup relocates the pnpm store in-project for caching.
# Never a tracked artifact.
.pnpm-store/

# build output
dist/
.next/
build/

# env
.env
.env.local
.env.*.local

# prisma
apps/api/prisma/dev.db
apps/api/src/generated/

# local dev database (pglite-backed Postgres, dev-only) -- the wildcard also
# covers a renamed-aside .pglite-data.crashed-<timestamp>/ backup left by the
# "rename rather than delete" recovery from a PGlite crash (see git history/
# session notes), not just the live directory.
apps/api/.pglite-data*/

# tesseract.js's downloaded OCR trained-data model (apps/api/src/services/
# ocr-service.ts) -- fetched to CWD on first use, a multi-MB binary cache,
# not source.
apps/api/*.traineddata

# storage (local filesystem article storage in dev)
apps/api/storage/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor/os
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# misc
*.tsbuildinfo
.turbo/
